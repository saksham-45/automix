# Core mix tuning
TRANSITION_LENGTH=30
TRANSITION_WINDOW=64
LUFS_TARGET=-14
SAMPLE_RATE=44100

# Feature toggles
ENABLE_AGENTIC_DURATION=false

# Paths
CACHE_DIR=./data/cache/stream
TEMP_DIR=./temp_audio

# Server
HOST=0.0.0.0
PORT=5005            # local dev; the container/HF Spaces default is 7860

# YouTube download
YTDLP_EXTRACTOR_ARGS=youtube:player_client=android
DOWNLOAD_TIMEOUT_SEC=120
# Netscape cookies.txt PATH for yt-dlp (datacenter-IP bot mitigation). In a container
# the entrypoint can instead take the cookies CONTENTS from the YT_COOKIES secret.
YT_COOKIES_FILE=

# Abuse / resource caps (memory-efficiency + security)
ALLOW_YOUTUBE=true
MAX_PLAYLIST_TRACKS=12
PER_TRACK_CAP_SEC=150
MAX_DOWNLOAD_MB=60
SESSION_TTL_SEC=1800
MAX_SESSIONS=24
RATE_LIMIT=30 per hour

# Render queue: renders running at once (demucs is heavy — keep 1 on CPU, raise on a
# GPU) and how many more may wait in line before /api/set/start answers 503.
MAX_CONCURRENT_RENDERS=1
MAX_QUEUE_LENGTH=4
# Cancel a queued/running render when its browser stops polling for this long.
ABANDON_AFTER_SEC=120

# Uploads (bring your own audio — the legal path for a public deployment).
# MAX_UPLOAD_MB is per file; MAX_PLAYLIST_TRACKS caps files per set/request.
ALLOW_UPLOADS=true
MAX_UPLOAD_MB=60
# Unused uploads are deleted after this long.
UPLOAD_TTL_SEC=3600
UPLOAD_RATE_LIMIT=120 per hour
# Tracks shorter than this are skipped (reported in the status `skipped` list).
MIN_TRACK_SEC=30

# Disk + subprocess bounds: CACHE_DIR cap (oldest downloaded tracks evicted first),
# and the timeout applied to every ffmpeg / ffprobe call.
MAX_CACHE_GB=5
FFMPEG_TIMEOUT_SEC=120

# Observability / HTTP. LOG_JSON=true prints one JSON object per line.
LOG_LEVEL=INFO
LOG_JSON=false
# Reverse proxies in front of the app (HF Spaces / Fly / nginx: 1) so rate limits
# see the client IP.
TRUST_PROXY_HOPS=0
# CSP frame-ancestors: none forbids framing. The HF Spaces page embeds the app in an
# iframe, so set https://huggingface.co there.
FRAME_ANCESTORS=none

# gunicorn (gunicorn.conf.py) — always ONE worker; these tune it.
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=180
GUNICORN_GRACEFUL_TIMEOUT=30
